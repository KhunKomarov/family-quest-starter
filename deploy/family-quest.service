[Unit]
Description=Family Quest journal
After=network.target

[Service]
Type=simple
User=family-quest
Group=family-quest
WorkingDirectory=/opt/family-quest
EnvironmentFile=/etc/family-quest/origin.env
ExecStart=/usr/bin/python3 /opt/family-quest/sync/server.py --origin ${FAMILY_QUEST_ORIGIN} --database /var/lib/family-quest/journal.sqlite3 --tokens /var/lib/family-quest/devices.json --parents /var/lib/family-quest/parents.json
Restart=on-failure
RestartSec=5s
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/family-quest

[Install]
WantedBy=multi-user.target
